// Triflare Fx "all blocks" showcase.
//
// Every built-in catalog block (all 248), plus the variable/list blocks that
// the language emits directly and the custom-procedure forms, so that
// `fx build examples/all-blocks` compiles the whole surface of the compiler.
//
// Blocks that return a value are consumed where a value is expected (usually
// `looks.say(...)` or an `if (...)` condition); command blocks are called as
// statements. Terminal blocks (`return`, `control.stop`, `control.deleteThisClone`)
// are deliberately the last statement of their stack — the editor gives them no
// next-statement connection.

stage {
    // ---- global (stage-scoped) state ------------------------------------
    let globalCounter = 0;
    cloud let globalCloud = 0;
    list globalItems = ["a", "b", "c"];

    when greenFlag {
        // backdrop blocks live on the Stage
        looks.switchBackdrop("backdrop1");
        looks.switchBackdropAndWait("backdrop1");
        looks.nextBackdrop();
        looks.say(looks.backdropNumber("number"));

        // variable + list data blocks
        globalCounter = 0;
        globalCounter += 1;
        globalCloud = 1;
        globalItems.push("d");
        globalItems.insert(1, "z");
        globalItems.replace(2, "y");
        globalItems.deleteAt(1);
        globalItems.show();
        globalItems.hide();
        looks.say(globalItems.itemAt(1));
        looks.say(globalItems.itemNumber("b"));
        looks.say(globalItems.length());
        if (globalItems.contains("b")) {
            looks.say("found");
        }
        globalItems.deleteAll();
    }

    // ---- every hat event on the Stage -----------------------------------
    when stageClicked {
        looks.nextBackdrop();
    }

    when backdropSwitchesTo("backdrop1") {
        looks.switchBackdrop("backdrop1");
    }

    when broadcast("stage ping") {
        looks.nextBackdrop();
    }

    when loudnessGreaterThan(10) {
    }

    when timerGreaterThan(10) {
    }

    when keyPressed("space") {
    }
}

sprite "AllBlocks" {
    layer: 1;
    costumes: {
        idle: "../../../assets/costumes/player_idle.svg"
    };

    let score = 0;
    let flag = false;
    list items = ["a", "b", "c"];

    // ---- custom procedure forms -----------------------------------------
    function noop() {
        looks.show();
    }

    function bump(amount: number, loud: boolean) {
        score += amount;
        if (loud) {
            looks.say("bump");
        }
    }

    returning function label() {
        if (score > 10) {
            return "Pro";
        }
        return "Rookie";
    }

    warp function fastNoop() {
        motion.changeX(1);
    }

    when greenFlag {
        // ---- motion (18) ------------------------------------------------
        motion.moveSteps(10);
        motion.turnRight(15);
        motion.turnLeft(15);
        motion.goToXY(0, 0);
        motion.goTo("_mouse_");
        motion.glideToXY(1, 50, 50);
        motion.glideTo(1, "_mouse_");
        motion.pointInDirection(90);
        motion.pointTowards("_mouse_");
        motion.changeX(10);
        motion.setX(0);
        motion.changeY(10);
        motion.setY(0);
        motion.ifOnEdgeBounce();
        motion.setRotationStyle("all around");
        looks.say(motion.xPosition());
        looks.say(motion.yPosition());
        looks.say(motion.direction());

        // ---- looks (21) -------------------------------------------------
        looks.say("hello");
        looks.sayForSecs("hello", 1);
        looks.think("hmm");
        looks.thinkForSecs("hmm", 1);
        looks.switchCostume("idle");
        looks.nextCostume();
        looks.changeSize(10);
        looks.setSize(100);
        looks.changeEffect("color", 25);
        looks.setEffect("ghost", 25);
        looks.clearEffects();
        looks.show();
        looks.hide();
        looks.goToFrontLayer("front");
        looks.goLayers("forward", 1);
        looks.say(looks.costumeNumber("number"));
        looks.say(looks.size());

        // ---- sound (9) --------------------------------------------------
        sound.play("pop");
        sound.playUntilDone("pop");
        sound.stopAllSounds();
        sound.changeEffect("pitch", 10);
        sound.setEffect("pitch", 10);
        sound.clearEffects();
        sound.changeVolume(-10);
        sound.setVolume(100);
        looks.say(sound.volume());

        // ---- sensing (17) -----------------------------------------------
        if (sensing.touching("_mouse_")) {
        }
        if (sensing.touchingColor("#ff0000")) {
        }
        if (sensing.colorIsTouchingColor("#ff0000", "#0000ff")) {
        }
        looks.say(sensing.distanceTo("_mouse_"));
        sensing.askAndWait("What is your name?");
        looks.say(sensing.answer());
        if (sensing.keyPressed("space")) {
        }
        if (sensing.mouseDown()) {
        }
        looks.say(sensing.mouseX());
        looks.say(sensing.mouseY());
        looks.say(sensing.loudness());
        looks.say(sensing.timer());
        sensing.resetTimer();
        looks.say(sensing.propertyOf("x position", "_stage_"));
        looks.say(sensing.current("year"));
        looks.say(sensing.daysSince2000());
        looks.say(sensing.username());

        // ---- operators (18) ---------------------------------------------
        looks.say(operators.add(1, 2));
        looks.say(operators.subtract(2, 1));
        looks.say(operators.multiply(2, 3));
        looks.say(operators.divide(6, 2));
        looks.say(operators.random(1, 6));
        if (operators.gt(2, 1)) {
        }
        if (operators.lt(1, 2)) {
        }
        if (operators.equals(1, 1)) {
        }
        if (operators.and(true, false)) {
        }
        if (operators.or(false, true)) {
        }
        if (operators.not(false)) {
        }
        looks.say(operators.join("a", "b"));
        looks.say(operators.letterOf(1, "abc"));
        looks.say(operators.length("abc"));
        if (operators.contains("abc", "b")) {
        }
        looks.say(operators.mod(5, 2));
        looks.say(operators.round(1.5));
        looks.say(operators.math("sqrt", 9));

        // ---- control (10) -----------------------------------------------
        control.wait(1);
        control.repeat(10) {
            looks.show();
        }
        control.if(true) {
            looks.show();
        }
        control.ifElse(false) {
            looks.show();
        } else {
            looks.hide();
        }
        control.waitUntil(false);
        control.repeatUntil(false) {
            looks.show();
        }
        control.stop("other scripts in sprite");
        control.clone("_myself_");

        // ---- events (2) -------------------------------------------------
        events.broadcast("scene ping");
        events.broadcastAndWait("scene ping");

        // ---- pen (9) ----------------------------------------------------
        pen.clear();
        pen.stamp();
        pen.penDown();
        pen.penUp();
        pen.setColor("#ff8800");
        pen.changeSize(1);
        pen.setSize(3);
        pen.changeColorParam("color", 10);
        pen.setColorParam("color", 50);

        // ---- penguinmod (3) ---------------------------------------------
        looks.say(pm.lastKeyPressed());
        if (pm.isCompiled()) {
        }
        if (pm.isPenguinMod()) {
        }

        // ---- data blocks -------------------------------------------------
        score = 0;
        score += 1;
        score -= 1;
        score *= 2;
        score /= 2;
        flag = true;
        items.push("d");
        items.insert(2, "e");
        items.replace(1, "f");
        items.deleteAt(3);
        items.show();
        items.hide();
        looks.say(items.itemAt(1));
        looks.say(items.itemNumber("f"));
        looks.say(items.length());
        if (items.contains("f")) {
        }
        items.deleteAll();

        // ---- PenguinMod-only blocks -------------------------------------
        control.backToGreenFlag();
        control.decrementCounter();
        control.deleteClonesOf("_myself_");
        looks.say(control.ifReturnElseReturn(true, "yes", "no"));
        control.javascriptCommand("console.log(1)");
        control.repeatForSeconds(1) {
            looks.show();
        }
        control.setCounter(0);
        control.stopSprite("_stage_");
        control.waitSecondsOrUntil(1, false);
        control.waitTick();

        looks.say(data.listAsArray(items));
        data.setListFromArray(items, "[\"x\", \"y\"]");
        if (data.itemExists(1, items)) {
        }
        if (data.listIsEmpty(items)) {
        }
        data.reverseList(items);
        data.forEachItem(items, score) {
            looks.show();
        }
        data.forEachIndex(items, score) {
            looks.show();
        }

        looks.changeStretch(15, 0);
        looks.changeVisibilityOf("show", "_myself_");
        looks.hideSprite("_myself_");
        looks.showSprite("_myself_");
        looks.say(looks.effectValue("COLOR"));
        if (looks.isSpriteVisible("_myself_")) {
        }
        if (looks.isVisible()) {
        }
        looks.say(looks.costumeInput("width", "idle"));
        looks.goToTargetLayer("infront", "_myself_");
        looks.say(looks.layer());
        looks.setLayer(1);
        looks.previousBackdrop();
        looks.previousCostume();
        looks.say(looks.sayHeight());
        looks.say(looks.sayWidth());
        looks.setBubbleColor("BUBBLE_STROKE", "#ff0000");
        looks.setFont("Helvetica", 14);
        looks.setTextBubbleShape("MIN_WIDTH", 0);
        looks.setStretch(100, 100);
        looks.setTintColor("#ff0000");
        looks.stopTalking();
        looks.say(looks.stretchX());
        looks.say(looks.stretchY());
        looks.say(looks.tintColor());

        motion.changeByXY(10, 10);
        motion.ifOnSpriteBounce("_mouse_");
        motion.ifOnXYBounce(0, 0);
        motion.moveToStageSide("bottom-left");
        motion.moveBackSteps(10);
        motion.moveUpDownSteps("up", 10);
        motion.pointInRandomDirection();
        motion.pointTowardsXY(0, 0);
        motion.turnAround();
        motion.turnLeftAroundXY(15, 0, 0);
        motion.turnRightAroundXY(15, 0, 0);

        looks.say(operators.advancedMath("^", 2, 3));
        looks.say(operators.advancedMathExpanded("root", 2, 3, 16));
        if (operators.boolify("true")) {
        }
        looks.say(operators.characterToCode("A"));
        looks.say(operators.codeToCharacter(65));
        looks.say(operators.constrain(50, 1, 100));
        looks.say(operators.countAppearances("a", "banana"));
        if (operators.falseValue()) {
        }
        looks.say(operators.lettersBetween(2, 4, "abcdef"));
        looks.say(operators.lettersBetweenFixed(2, 4, "abcdef"));
        if (operators.gte(2, 1)) {
        }
        looks.say(operators.indexOf("world", "Hello world!"));
        if (operators.javascriptBoolean("true")) {
        }
        looks.say(operators.javascriptOutput("1 + 1"));
        looks.say(operators.join3("a", "b", "c"));
        looks.say(operators.lastIndexOf("o", "foo"));
        looks.say(operators.interpolate(1, 3, 0.5));
        if (operators.lte(1, 2)) {
        }
        if (operators.nand(true, false)) {
        }
        looks.say(operators.newLine());
        if (operators.nor(false, false)) {
        }
        if (operators.notEqual(1, 2)) {
        }
        looks.say(operators.power(2, 3));
        if (operators.randomBoolean()) {
        }
        looks.say(operators.readLine(1, "a\nb"));
        looks.say(operators.regexMatch("foo bar", "foo", "g"));
        looks.say(operators.replaceAll("foo bar", "foo", "baz"));
        looks.say(operators.replaceFirst("bar bar", "bar", "foo"));
        looks.say(operators.stringify("foo"));
        looks.say(operators.tabCharacter());
        if (operators.includesLetterFrom("abc", "bcd")) {
        }
        if (operators.startsWithOrEndsWith("starts", "abcdef", "abc")) {
        }
        looks.say(operators.toCase("upper", "hello"));
        if (operators.trueValue()) {
        }
        if (operators.xnor(true, true)) {
        }
        if (operators.xor(true, false)) {
        }

        looks.say(sensing.directionBetween(-10, 10, 10, -10));
        looks.say(sensing.distanceBetween(10, -10, -10, 10));
        if (sensing.fingerDown("1")) {
        }
        if (sensing.fingerTapped("1")) {
        }
        looks.say(sensing.fingerX("1"));
        looks.say(sensing.fingerY("1"));
        looks.say(sensing.browser());
        looks.say(sensing.clipboard());
        if (sensing.isDraggable()) {
        }
        looks.say(sensing.operatingSystem());
        looks.say(sensing.spriteWithAttribute("x position", "10"));
        looks.say(sensing.url());
        looks.say(sensing.touchingSpritePoint("x", "_mouse_"));
        if (sensing.isUpperCase("A")) {
        }
        if (sensing.keyHit("space")) {
        }
        if (sensing.loggedIn()) {
        }
        if (sensing.isMobile()) {
        }
        if (sensing.mouseClicked()) {
        }
        if (sensing.mouseScrolling("up")) {
        }
        if (sensing.objectTouchingClone("_mouse_", "_myself_")) {
        }
        if (sensing.objectTouchingObject("_mouse_", "_myself_")) {
        }
        if (sensing.regexTest("foo bar", "foo", "g")) {
        }
        sensing.setClipboard("hi");
        if (sensing.hasNumber("10")) {
        }
        if (sensing.isNumber("10")) {
        }
        if (sensing.isText("abc")) {
        }

        looks.say(sound.effectValue("PITCH"));
        looks.say(sound.lengthOf("pop"));
        looks.say(sound.soundVolume("pop"));
        if (sound.isPlaying("pop")) {
        }
        sound.playAt("pop", 1);
        sound.playAtUntilDone("pop", 1);
        sound.playAllSounds();
        sound.setFadeOut(1, "pop");
        sound.stop("pop");

        // Terminal loop blocks end their own stack inside the loop body.
        control.repeat(1) {
            control.continueLoop();
        }
        control.repeat(1) {
            control.escapeLoop();
        }

        // ---- custom procedures ------------------------------------------
        noop();
        bump(2, true);
        fastNoop();
        looks.say(label());

        // ---- infix expressions & precedence -----------------------------
        looks.say(1 + 2 * 3 - 4 / 2 % 3);
        if (score > 0 and score < 100) {
        }
        if (score == 0 or score != 1) {
        }
        if (not (score < 0)) {
        }

        // `control.forever` is dynamic: PenguinMod only gives it a
        // next-statement nub once a block sits below it. The
        // `when keyPressed("z")` hat below exercises that `hasbreak` mutation.
        control.forever {
            motion.turnRight(1);
        }
    }

    // ---- the remaining hat events on a sprite ---------------------------
    when keyPressed("a") {
        score += 1;
    }

    when spriteClicked {
        looks.say("clicked");
    }

    when cloneStart {
        control.deleteThisClone();
    }

    when broadcast("scene ping") {
        looks.show();
    }

    // PenguinMod's compiler emits a missing closing parenthesis for the
    // `operator_advlog` reporter, which makes the whole script fail to parse.
    // Keep the block in a broadcast that is never sent: it still covers the
    // catalog and decompiler without breaking the playable showcase.
    when broadcast("advanced log (never sent)") {
        looks.say(operators.advancedLog(8, 2));
    }

    // ---- the remaining PenguinMod-only hat events ----------------------
    when always {
        score += 0;
    }

    when whenAnything(true) {
        looks.show();
    }

    when whenJavaScript("1 + 1") {
        looks.show();
    }

    when whenKeyHit("space") {
        looks.show();
    }

    when whenMouseScrolled("up") {
        looks.show();
    }

    when whenStopClicked {
        looks.show();
    }

    // Exercises PenguinMod's loop nub: a forever loop with a block stacked
    // below it needs the `hasbreak` mutation to survive an editor round-trip.
    when keyPressed("z") {
        control.forever {
            looks.show();
        }
        looks.hide();
    }

    // Terminal stop variants (each must be the last statement of its stack).
    when keyPressed("q") {
        control.stop("all");
    }

    when keyPressed("w") {
        control.stop("this script");
    }
}
