{
  "name": "@triflare/fx",
  "version": "0.0.0",
  "description": "Code PenguinMod projects with text.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.js",
  "bin": {
    "fx": "bin/fx.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triflare/fx.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js",
    "./language": "./src/language.js",
    "./lint": "./src/lint/analyze.js"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "bin",
    "src",
    "vendor/pm-packager-dist",
    "vendor/pm-vm-dist",
    "vendor/tempvars",
    "product.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run test; npm run lint; npm run format:check",
    "pretest": "npm run build:vm",
    "test": "node --test test/*.test.js",
    "build:example": "node bin/fx.js build examples/player -o build/player.pmp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:packager && npm run build:vm",
    "build:packager": "node scripts/build-packager.js",
    "build:vm": "node scripts/build-vm.js",
    "prepack": "node scripts/build-packager.js --if-missing && node scripts/build-vm.js --if-missing"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@fiahfy/icns": "0.0.7",
    "@turbowarp/sbdl": "^7.0.0",
    "commander": "^15.0.0",
    "cross-fetch": "^4.1.0",
    "decode-html": "2.0.0",
    "format-message": "6.2.4",
    "htmlparser2": "^12.0.0",
    "immutable": "^3.8.4",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.1",
    "minilog": "3.1.0",
    "quickjs-emscripten": "^0.32.0",
    "scratch-parser": "github:PenguinMod/PenguinMod-Parser#ad93a6d0d20bcb4374e531ecf20b87b861faf9fb",
    "sha.js": "^2.4.12",
    "text-encoding": "0.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "semantic-release": "^25.0.9"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "taffydb": "file:vendor/taffydb",
    "dompurify": "^3.4.17",
    "immutable": "^3.8.4",
    "webpack": "^5.111.1",
    "scratch-parser": {
      "ajv": "^6.15.0",
      "jszip": "^3.10.2"
    }
  }
}
