{
  "name": "@triflare/fx",
  "version": "1.0.0",
  "description": "Code PenguinMod projects with text.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.js",
  "bin": {
    "fx": "bin/fx.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js",
    "./language": "./src/language.js"
  },
  "files": [
    "bin",
    "src",
    "product.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run test; npm run lint; npm run format:check",
    "test": "node --test test/*.test.js",
    "build:example": "node bin/fx.js build examples/player -o build/player.pmp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "js-yaml": "^5.4.3",
    "quickjs-emscripten": "^0.32.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "scratch-vm": "github:PenguinMod/PenguinMod-Vm#75ef6994e55270b9c2a2f3cb2edf6a5bf31cdf2a"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "taffydb": "file:vendor/taffydb",
    "dompurify": "^3.4.17",
    "immutable": "^3.8.4",
    "webpack": "^5.111.1",
    "scratch-parser": {
      "ajv": "^6.15.0",
      "jszip": "^3.10.2"
    }
  }
}
