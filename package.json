{
  "name": "@triflare/fx",
  "version": "2.1.0",
  "description": "Code PenguinMod projects with text.",
  "type": "module",
  "license": "Apache-2.0",
  "main": "src/index.js",
  "bin": {
    "fx": "bin/fx.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/triflare/fx.git"
  },
  "exports": {
    ".": "./src/index.js",
    "./catalog": "./src/catalog.js",
    "./language": "./src/language.js"
  },
  "files": [
    "bin",
    "src",
    "vendor/pm-packager-dist",
    "product.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "npm run test; npm run lint; npm run format:check",
    "test": "node --test test/*.test.js",
    "build:example": "node bin/fx.js build examples/player -o build/player.pmp",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build:packager",
    "build:packager": "node scripts/build-packager.js",
    "prepack": "node scripts/build-packager.js --if-missing"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@fiahfy/icns": "0.0.7",
    "@turbowarp/sbdl": "^7.0.0",
    "commander": "^15.0.0",
    "cross-fetch": "^4.1.0",
    "js-yaml": "^5.4.3",
    "jszip": "^3.10.1",
    "quickjs-emscripten": "^0.32.0",
    "sha.js": "^2.4.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "scratch-vm": "github:PenguinMod/PenguinMod-Vm#75ef6994e55270b9c2a2f3cb2edf6a5bf31cdf2a"
  },
  "overrides": {
    "minimatch": "^11.0.4",
    "taffydb": "file:vendor/taffydb",
    "dompurify": "^3.4.17",
    "immutable": "^3.8.4",
    "webpack": "^5.111.1",
    "scratch-parser": {
      "ajv": "^6.15.0",
      "jszip": "^3.10.2"
    }
  }
}
