{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Triflare Fx",
  "scopeName": "source.fx",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#block-calls" },
    { "include": "#temp-vars" },
    { "include": "#hat-events" },
    { "include": "#property-keys" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.fx",
          "match": "//.*$"
        },
        {
          "name": "comment.block.fx",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.fx",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "include": "#string-escapes" }]
        },
        {
          "name": "string.quoted.single.fx",
          "begin": "'",
          "end": "'",
          "patterns": [{ "include": "#string-escapes" }]
        }
      ]
    },
    "string-escapes": {
      "name": "constant.character.escape.fx",
      "match": "\\\\(n|t|r|\"|'|\\\\)"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.fx",
          "match": "\\b\\d+(\\.\\d+)?([eE][+-]?\\d+)?\\b"
        },
        {
          "name": "constant.numeric.fx",
          "match": "(?<![\\w.])\\.\\d+([eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "block-calls": {
      "patterns": [
        {
          "match": "\\b(motion|looks|sound|sensing|operators|control|events|pen|pm|tempvars)(\\.)([A-Za-z_$][\\w$]*)",
          "captures": {
            "1": { "name": "support.module.fx" },
            "2": { "name": "punctuation.accessor.fx" },
            "3": { "name": "support.function.fx" }
          }
        }
      ]
    },
    "temp-vars": {
      "patterns": [
        {
          "match": "\\$\\$?[A-Za-z_][\\w$]*",
          "name": "variable.other.temp.fx"
        }
      ]
    },
    "hat-events": {
      "patterns": [
        {
          "match": "\\b(greenFlag|keyPressed|spriteClicked|stageClicked|cloneStart|broadcast|broadcastReceived|backdropSwitchesTo|loudnessGreaterThan|timerGreaterThan)\\b(?=\\s*[({]|\\s*$)",
          "name": "support.function.hat.fx"
        }
      ]
    },
    "property-keys": {
      "patterns": [
        {
          "match": "\\b(layer|costumes|sounds)\\b(?=\\s*:)",
          "name": "variable.other.property.fx"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(partial)(?=\\s+sprite\\b)",
          "name": "keyword.other.modifier.fx"
        },
        {
          "match": "\\bsprite\\b(?=\\s*\")",
          "name": "keyword.other.sprite.fx"
        },
        {
          "match": "\\bstage\\b(?=\\s*\\{)",
          "name": "keyword.other.stage.fx"
        },
        {
          "match": "\\b(let|cloud|list|function|returning|warp)\\b",
          "name": "keyword.other.declaration.fx"
        },
        {
          "match": "\\b(thread|runtime)\\b(?=\\s+let\\b)",
          "name": "keyword.other.temporary.fx"
        },
        {
          "match": "\\b(when|if|else|repeat|while|forever|return)\\b",
          "name": "keyword.control.fx"
        },
        {
          "match": "\\b(and|or|not)\\b",
          "name": "keyword.operator.word.fx"
        },
        {
          "match": "\\b(boolean|number|string)\\b(?=\\s*[,)])",
          "name": "storage.type.fx"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "\\b(true|false)\\b",
          "name": "constant.language.fx"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "match": "(\\+=|-=|\\*=|/=|==|!=|<=|>=|&&|\\|\\||[+\\-*/%=<>!])",
          "name": "keyword.operator.fx"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "match": "[{}]",
          "name": "punctuation.section.block.fx"
        },
        {
          "match": "[()]",
          "name": "punctuation.section.group.fx"
        },
        {
          "match": "[\\[\\]]",
          "name": "punctuation.section.array.fx"
        },
        {
          "match": ",",
          "name": "punctuation.separator.fx"
        },
        {
          "match": ";",
          "name": "punctuation.terminator.fx"
        },
        {
          "match": ":",
          "name": "punctuation.separator.key-value.fx"
        },
        {
          "match": "\\.",
          "name": "punctuation.accessor.fx"
        }
      ]
    }
  }
}
