{
  "name": "fx-language-features",
  "displayName": "Triflare Fx Language Features",
  "description": "Language features for Triflare Fx.",
  "version": "2.1.0",
  "publisher": "triflare",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/triflare/fx",
    "directory": "editors/vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "fx",
        "aliases": [
          "Triflare Fx",
          "fx"
        ],
        "extensions": [
          ".tfx"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "snippets": [
      {
        "language": "fx",
        "path": "./snippets/fx.json"
      }
    ],
    "grammars": [
      {
        "language": "fx",
        "scopeName": "source.fx",
        "path": "./syntaxes/fx.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:web": "npm run build && node .vscode-test.mjs",
    "package": "npm run build && vsce package"
  },
  "devDependencies": {
    "@types/vscode": "1.85",
    "@vscode/test-web": "^0.0.81",
    "@vscode/vsce": "^4.1.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.5.0",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "minimatch": "^11.0.4"
  },
  "allowScripts": {
    "@playwright/browser-chromium@1.64.1": true,
    "@vscode/vsce-sign@2.1.0": true,
    "esbuild@0.28.2": true
  }
}
